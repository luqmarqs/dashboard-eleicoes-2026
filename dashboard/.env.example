# Copie para .env.local. A chave "anon" é pública por definição; o acesso aos dados é protegido
# pelo login + RLS no Supabase.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
# "supabase" (padrão) ou "dev" (arquivos locais de dev-data/, só no `npm run dev`)
VITE_DATA_SOURCE=supabase
